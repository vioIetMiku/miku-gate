# Generated by scripts/frontend.py. This service owns only static UI and proxying.
worker_processes auto;
pid /tmp/miku-nginx.pid;
error_log /dev/stderr warn;
events { worker_connections 256; }
http {
    include /etc/nginx/mime.types;
    default_type application/octet-stream;
    access_log off;
    server_tokens off;
    client_body_temp_path /tmp/client_body;
    proxy_temp_path /tmp/proxy;
    fastcgi_temp_path /tmp/fastcgi;
    uwsgi_temp_path /tmp/uwsgi;
    scgi_temp_path /tmp/scgi;
    client_max_body_size 4m;
    client_header_timeout 15s;
    client_body_timeout 30s;
    send_timeout 30s;
    keepalive_timeout 30s;
    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml;

    # Accept only the configured browser origin. Normalize it for the backend's
    # existing same-origin check; an arbitrary browser Origin is never trusted.
    map $http_origin $miku_origin_allowed {
        default 0;
        "" 1;
        "@@FRONTEND_ORIGIN@@" 1;
    }
    map $http_origin $miku_backend_origin {
        default "";
        "@@FRONTEND_ORIGIN@@" "@@BACKEND_ORIGIN@@";
    }

    server {
        listen @@LISTEN@@:@@PORT@@;
        server_name _;
        if ($miku_origin_allowed = 0) { return 403; }
        add_header X-Content-Type-Options nosniff always;
        add_header Referrer-Policy same-origin always;
        add_header X-Frame-Options SAMEORIGIN always;

        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host "@@BACKEND_HOST@@";
        proxy_set_header Origin $miku_backend_origin;
        proxy_set_header X-Forwarded-Proto "@@BACKEND_SCHEME@@";
        proxy_set_header X-Forwarded-For "";
        proxy_set_header Forwarded "";
        proxy_connect_timeout 10s;
        proxy_read_timeout 180s;
        proxy_send_timeout 60s;
        proxy_ssl_server_name on;
        proxy_ssl_name "@@TLS_NAME@@";
        proxy_ssl_verify on;
        proxy_ssl_trusted_certificate /etc/ssl/certs/ca-certificates.crt;
        proxy_cookie_flags miku_session @@COOKIE_FLAG@@;

        location = /_miku_health { access_log off; return 200 "ok\n"; }
        @@BASE_REDIRECT@@
        location = @@BASE@@/ {
            auth_request /_miku_session;
            error_page 401 =200 /_miku_login;
            default_type text/html;
            add_header Cache-Control no-store always;
            root /usr/share/nginx/html;
            try_files /index.html =404;
        }
        location = /_miku_session {
            internal;
            proxy_pass @@BACKEND_URL@@@@BASE@@/api/ping;
            proxy_pass_request_body off;
            proxy_set_header Content-Length "";
            # Location-level proxy headers replace the inherited set.
            proxy_set_header Host "@@BACKEND_HOST@@";
            proxy_set_header X-Forwarded-Proto "@@BACKEND_SCHEME@@";
            proxy_set_header Origin "";
            proxy_set_header X-Forwarded-For "";
            proxy_set_header Forwarded "";
        }
        location = /_miku_login {
            internal;
            default_type text/html;
            add_header Cache-Control no-store always;
            alias /usr/share/nginx/html/login.html;
        }
        location ^~ @@BASE@@/static/ {
            alias /usr/share/nginx/html/static/;
            add_header Cache-Control no-cache always;
        }
        location ^~ @@BASE@@/assets/ {
            alias /usr/share/nginx/html/assets/;
            add_header Cache-Control "public, max-age=86400";
        }
        location ^~ @@BASE@@/api/ {
            proxy_pass @@BACKEND_URL@@;
            add_header Cache-Control no-store always;
        }
        # Container images are upgraded by the deployment script, never by
        # replacing a binary inside a running backend container.
        location = @@BASE@@/api/update/apply {
            default_type application/json;
            return 409 '{"error":"Docker 部署请使用 bash install-docker.sh update"}';
        }
        location = @@BASE@@/login {
            limit_except POST { deny all; }
            proxy_pass @@BACKEND_URL@@;
            add_header Cache-Control no-store always;
        }
        location = @@BASE@@/sub {
            proxy_pass @@BACKEND_URL@@;
            add_header Cache-Control no-store always;
        }
        location / { return 404; }
    }
}
