# Copy to .env in the deployment directory. Keep existing .env on upgrades.
# Ports are preferences, not fixed requirements. Busy/reserved ports auto-fallback.
# Empty WEB_PORT: prefer saved actual port; first start tries 8899.
WEB_PORT=
# Optional public IPv4 override when automatic detection is unavailable.
MIKU_PUBLIC_IP=
# 0 = no software tunnel limit.
MIKU_MAX_SLOTS=0
# Release bundles use verified prebuilt binaries. Source checkouts can use source.
# MIKU_BINARY_SOURCE=source

# Empty: prefer saved actual frontend port; first start tries 8900.
MIKU_FRONTEND_PORT=
MIKU_FRONTEND_LISTEN=0.0.0.0
# Browser origin WITHOUT the random path. Empty = http://public-IP:actual-port.
# Set for external HTTPS or a remote backend, e.g. https://panel.example.com.
# A fixed external origin is not rewritten when the internal port changes;
# update your external reverse proxy to the actual port printed by frontend info.
MIKU_FRONTEND_ORIGIN=
# Local deployment: leave these empty to read backend's actual port/path/TLS.
# Remote example: https://api.example.com:9443 (no path).
MIKU_BACKEND_URL=
# Required for an explicit backend: its real random path, or / for root.
MIKU_BACKEND_BASE_PATH=
# Optional Host header and TLS certificate name, e.g. api.example.com:9443.
MIKU_BACKEND_HOST=
